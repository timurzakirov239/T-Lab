# Исходные данные и результаты экспериментов могут быть большими.
**/data/raw/**
!**/data/raw/**/
!**/data/raw/**/.gitkeep
**/data/processed/**
!**/data/processed/**/
!**/data/processed/**/.gitkeep
**/artifacts/**
!**/artifacts/**/
!**/artifacts/**/.gitkeep

# Локальные окружения и кеши Python.
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.env
.env.*
!.env.example
*.pem
*.key
/backups/
*.log

# Локальное состояние окон Obsidian; общие настройки хранилища сохраняем.
**/.obsidian/workspace*.json
**/.obsidian/cache/
**/.obsidian/workspaces.json
**/.obsidian/plugins/
.trash/

# Local submission delivery and PDF previews; published as release assets.
/output/
/tmp/
